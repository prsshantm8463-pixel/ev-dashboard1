    <!-- JAVASCRIPT CONTROLLERS -->
    <script>
        // Tab Switcher
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('bg-brand-500/20', 'text-brand-400', 'border', 'border-brand-500/30');
                el.classList.add('text-slate-400');
            });

            document.getElementById('tab-' + tabId).classList.remove('hidden');
            const activeNav = document.getElementById('nav-' + tabId);
            activeNav.classList.add('bg-brand-500/20', 'text-brand-400', 'border', 'border-brand-500/30');
            activeNav.classList.remove('text-slate-400');

            if (tabId === 'analytics') {
                renderCharts();
            }
        }

        // Modal Controls
        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

        // Toast Trigger
        function triggerToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3500);
        }

        // AI Chat Simulator
        function handleChatSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('chatInput');
            const val = input.value.trim();
            if (!val) return;

            appendUserMsg(val);
            input.value = '';

            setTimeout(() => {
                appendAIMsg("Analyzing IBEF database for: '" + val + "'... The current policy framework guarantees GST at 5% for EVs and offers up to ₹15,000 subsidy per kWh for commercial battery packs.");
            }, 800);
        }

        function sendQuickPrompt(promptText) {
            appendUserMsg(promptText);
            setTimeout(() => {
                if (promptText.includes('PLI')) {
                    appendAIMsg("PLI Auto Scheme: Allocation of ₹25,938 Cr incentivizes domestic EV component manufacturing with sales value incentives ranging from 8% to 13%.");
                } else if (promptText.includes('GST')) {
                    appendAIMsg("EV GST Rates: Electric Vehicles attract 5% GST (vs 28% for internal combustion engine vehicles). EV chargers attract 5% GST.");
                } else {
                    appendAIMsg("Executive Summary generated: FAME III allocates enhanced capital subsidies for charging infrastructure hubs across 40 major tier-1 and tier-2 cities.");
                }
            }, 700);
        }

        function appendUserMsg(txt) {
            const log = document.getElementById('chatLog');
            log.innerHTML += `
                <div class="flex space-x-3 justify-end">
                    <div class="bg-brand-500/20 text-brand-300 p-3 rounded-lg max-w-[85%] border border-brand-500/30">
                        ${txt}
                    </div>
                </div>
            `;
            log.scrollTop = log.scrollHeight;
        }

        function appendAIMsg(txt) {
            const log = document.getElementById('chatLog');
            log.innerHTML += `
                <div class="flex space-x-3">
                    <div class="w-7 h-7 rounded bg-brand-500/20 text-brand-400 flex items-center justify-center flex-shrink-0 border border-brand-500/30">AI</div>
                    <div class="bg-slate-800 text-slate-200 p-3 rounded-lg max-w-[85%] border border-slate-700">
                        ${txt}
                    </div>
                </div>
            `;
            log.scrollTop = log.scrollHeight;
        }

        function clearChat() {
            document.getElementById('chatLog').innerHTML = `
                <div class="flex space-x-3">
                    <div class="w-7 h-7 rounded bg-brand-500/20 text-brand-400 flex items-center justify-center flex-shrink-0 border border-brand-500/30">AI</div>
                    <div class="bg-slate-800 text-slate-200 p-3 rounded-lg max-w-[85%] border border-slate-700">
                        Chat log cleared. Ready for new EV industry compliance queries.
                    </div>
                </div>
            `;
        }

        // Fleet Filter
        function filterFleet(type) {
            const cards = document.querySelectorAll('.fleet-card');
            cards.forEach(card => {
                if (type === 'all' || card.classList.contains(type)) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        // Dealer Calc
        function calculateSubsidy() {
            const seg = parseInt(document.getElementById('calcSegment').value);
            document.getElementById('subsidyAmt').innerText = '₹' + seg.toLocaleString('en-IN');
            document.getElementById('calcResult').classList.remove('hidden');
        }

        function generateTemplate(type) {
            if (type === 'warranty') {
                triggerToast("Generated: 8-Year Battery Degradation Guarantee PDF shared to CRM.");
            } else {
                triggerToast("Generated: Home Fast-Charger Site Readiness Form copied.");
            }
        }

        function downloadReport() {
            triggerToast("Downloading Phase II EV Communication Executive Report (PDF)...");
        }

        // Chart.js Rendering
        let chartsRendered = false;
        function renderCharts() {
            if (chartsRendered) return;
            chartsRendered = true;

            const ctx1 = document.getElementById('chartSales').getContext('2d');
            new Chart(ctx1, {
                type: 'line',
                data: {
                    labels: ['2020', '2022', '2024', '2026E', '2028E', '2030E'],
                    datasets: [{
                        label: 'Electric 2W/3W',
                        data: [120, 450, 1100, 1820, 3200, 6500],
                        borderColor: '#22c55e',
                        backgroundColor: 'rgba(34, 197, 94, 0.1)',
                        fill: true,
                        tension: 0.3
                    }, {
                        label: 'Passenger 4W',
                        data: [15, 60, 180, 420, 950, 2100],
                        borderColor: '#06b6d4',
                        backgroundColor: 'rgba(6, 182, 212, 0.1)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#94a3b8', font: { size: 10 } } } },
                    scales: {
                        x: { ticks: { color: '#64748b' }, grid: { color: '#1f2937' } },
                        y: { ticks: { color: '#64748b' }, grid: { color: '#1f2937' } }
                    }
                }
            });

            const ctx2 = document.getElementById('chartSentiment').getContext('2d');
            new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: ['Positive (Range Clarity)', 'Neutral (Awaiting Subsidy)', 'Concern (Infra Density)'],
                    datasets: [{
                        data: [58, 27, 15],
                        backgroundColor: ['#22c55e', '#3b82f6', '#f59e0b'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { color: '#94a3b8', font: { size: 10 } } } }
                }
            });
        }
    </script>
